<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API < 31): back up the session/identity sharedprefs so a
    reinstall restores the login. The server session is re-validated on next
    launch; even an expired token lands on home via local trust, and the
    loginId prefill covers the worst case. Device id is excluded on purpose:
    a fresh install must mint its own device id for guest-data claims. -->
<full-backup-content>
    <include domain="sharedpref" path="auth_session.xml"/>
    <include domain="sharedpref" path="data_owner.xml"/>
    <exclude domain="sharedpref" path="device.xml"/>
</full-backup-content>
