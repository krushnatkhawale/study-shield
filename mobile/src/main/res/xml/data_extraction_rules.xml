<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup + device transfer (API 31+): same policy as backup_rules —
    restore session/identity prefs, never the device id. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="auth_session.xml"/>
        <include domain="sharedpref" path="data_owner.xml"/>
        <exclude domain="sharedpref" path="device.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="auth_session.xml"/>
        <include domain="sharedpref" path="data_owner.xml"/>
        <exclude domain="sharedpref" path="device.xml"/>
    </device-transfer>
</data-extraction-rules>
